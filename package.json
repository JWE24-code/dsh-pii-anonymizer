{
  "name": "dsh-pii-anonymizer",
  "version": "0.1.0",
  "description": "Deterministic, one-way PII anonymizer at the start of the DeepSeek Harness agent loop",
  "type": "module",
  "license": "MIT",
  "author": "JWE24-code <292770342+JWE24-code@users.noreply.github.com>",
  "homepage": "https://github.com/JWE24-code/dsh-pii-anonymizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWE24-code/dsh-pii-anonymizer.git"
  },
  "bugs": "https://github.com/JWE24-code/dsh-pii-anonymizer/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "pii",
    "anonymizer",
    "privacy",
    "security",
    "redaction"
  ],
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./anonymizer": "./src/anonymizer.mjs",
    "./detectors": "./src/detectors.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src/**/*.mjs",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "sonar:issues": "node tools/sonar-issues.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
